# Cadena de conexión MySQL
# Local (MySQL Workbench):   mysql://root:TU_PASSWORD@localhost:3306/gym_access
# Railway (variable de referencia): ${{MySQL.MYSQL_URL}}
DATABASE_URL="mysql://root:password@localhost:3306/gym_access"

# NextAuth: genera un secreto con `openssl rand -base64 32`
NEXTAUTH_SECRET="cambia-este-secreto-por-uno-largo-y-aleatorio"
# URL pública de la app (en Railway: https://tu-app.up.railway.app)
NEXTAUTH_URL="http://localhost:3000"

# Zona horaria del negocio (horarios de acceso, cierres de caja, vencimientos)
APP_TIMEZONE="America/Bogota"
# Nombre visible del gimnasio
NEXT_PUBLIC_GYM_NAME="Esparta Gym"
# Cargar datos de demostración automáticamente si la BD está vacía (true/false)
SEED_ON_EMPTY="true"
