// ─────────────────────────────────────────────────────────────────────────────
//  Sistema Integral de Control de Acceso y Gestión de Membresías para Gimnasios
//  ORM: Prisma 7 (cliente sin motor Rust + adaptador MariaDB/MySQL)
//  Base de datos: MySQL 8+  (la conexión se define en prisma.config.ts → DATABASE_URL)
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

// ───────────────────────────── Enumeraciones ────────────────────────────────

enum Rol {
  ADMINISTRADOR
  RECEPCIONISTA
  INSTRUCTOR
  FINANZAS
}

enum TipoDocumento {
  CC
  TI
  CE
  PASAPORTE
}

enum EstadoSocio {
  ACTIVO
  VENCIDO
  CONGELADO
  BLOQUEADO_POR_MORA
}

enum TipoPlan {
  MENSUAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
  DIARIO
}

enum EstadoMembresia {
  ACTIVA
  CANCELADA
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
}

enum ConceptoPago {
  MEMBRESIA
  ABONO
  OTRO
}

enum Turno {
  MANANA
  TARDE
  NOCHE
}

enum EstadoCaja {
  ABIERTA
  CERRADA
}

enum MetodoAcceso {
  DOCUMENTO
  QR
}

enum ResultadoAcceso {
  PERMITIDO
  DENEGADO
}

enum TipoAcceso {
  SOCIO
  INVITADO
}

enum EstadoReserva {
  CONFIRMADA
  CANCELADA
  ASISTIO
}

// ─────────────────────────────── Modelos ────────────────────────────────────

/// Personal del gimnasio que inicia sesión en el sistema.
model Usuario {
  id           Int      @id @default(autoincrement())
  nombre       String   @db.VarChar(120)
  email        String   @unique @db.VarChar(160)
  passwordHash String   @db.VarChar(100)
  rol          Rol
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  membresiasVendidas Membresia[]        @relation("VendidaPor")
  pagos              Pago[]
  cajas              CajaTurno[]
  congelamientos     Congelamiento[]
  invitados          Invitado[]
  accesos            Acceso[]
  clases             ClaseGrupal[]
  evaluaciones       EvaluacionFisica[]

  @@map("usuarios")
}

/// Catálogo de planes comerciales y sus reglas de acceso.
model Plan {
  id                    Int      @id @default(autoincrement())
  codigo                String   @unique @db.VarChar(30)
  nombre                String   @db.VarChar(80)
  descripcion           String   @db.Text
  tipo                  TipoPlan
  duracionDias          Int
  precio                Decimal  @db.Decimal(12, 2)
  invitadosMes          Int      @default(0)
  evaluacionesIncluidas Int      @default(0)
  valoracionMensual     Boolean  @default(false)
  lockerIncluido        Boolean  @default(false)
  maxDiasCongelamiento  Int      @default(0)
  accesoPreferencial    Boolean  @default(false)
  /// Máximo de ingresos por día (0 = ilimitado)
  accesosPorDia         Int      @default(1)
  /// Hora de inicio permitida, formato HH:MM (24h)
  horaInicio            String   @default("05:00") @db.VarChar(5)
  /// Hora de cierre permitida, formato HH:MM (24h)
  horaFin               String   @default("22:00") @db.VarChar(5)
  /// Días ISO permitidos separados por coma (1 = lunes … 7 = domingo)
  diasPermitidos        String   @default("1,2,3,4,5,6,7") @db.VarChar(20)
  activo                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  membresias Membresia[]

  @@map("planes")
}

/// Persona inscrita en el gimnasio (titular de membresías).
model Socio {
  id                          Int           @id @default(autoincrement())
  tipoDocumento               TipoDocumento @default(CC)
  documento                   String        @unique @db.VarChar(30)
  nombres                     String        @db.VarChar(80)
  apellidos                   String        @db.VarChar(80)
  fechaNacimiento             DateTime?     @db.Date
  genero                      String?       @db.VarChar(20)
  email                       String?       @db.VarChar(160)
  telefono                    String        @db.VarChar(30)
  direccion                   String?       @db.VarChar(200)
  fotoUrl                     String?       @db.MediumText
  contactoEmergenciaNombre    String        @db.VarChar(120)
  contactoEmergenciaTelefono  String        @db.VarChar(30)
  contactoEmergenciaParentesco String?      @db.VarChar(40)
  observacionesMedicas        String?       @db.Text
  /// Token único codificado en el QR del carnet
  qrToken                     String        @unique @db.VarChar(64)
  /// Estado calculado y sincronizado en tiempo real por el motor de reglas
  estado                      EstadoSocio   @default(VENCIDO)
  lockerNumero                Int?          @unique
  createdAt                   DateTime      @default(now())
  updatedAt                   DateTime      @updatedAt

  membresias   Membresia[]
  pagos        Pago[]
  accesos      Acceso[]
  invitados    Invitado[]
  reservas     Reserva[]
  evaluaciones EvaluacionFisica[]

  @@index([estado])
  @@index([apellidos, nombres])
  @@map("socios")
}

/// Venta de un plan a un socio, con vigencia y saldo.
model Membresia {
  id               Int             @id @default(autoincrement())
  socioId          Int
  planId           Int
  fechaInicio      DateTime        @db.Date
  /// Fecha fin original según la duración del plan
  fechaFin         DateTime        @db.Date
  /// Fecha fin real (fechaFin + días congelados)
  fechaFinAjustada DateTime        @db.Date
  precioLista      Decimal         @db.Decimal(12, 2)
  descuento        Decimal         @default(0) @db.Decimal(12, 2)
  /// Valor a pagar = precioLista - descuento
  montoTotal       Decimal         @db.Decimal(12, 2)
  diasCongelados   Int             @default(0)
  estado           EstadoMembresia @default(ACTIVA)
  /// Pase diario cuyo valor se abonó a esta membresía (regla de 48 horas)
  abonoDayPassId   Int?            @unique
  vendidaPorId     Int?
  notas            String?         @db.VarChar(255)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  socio          Socio           @relation(fields: [socioId], references: [id], onDelete: Cascade)
  plan           Plan            @relation(fields: [planId], references: [id])
  vendidaPor     Usuario?        @relation("VendidaPor", fields: [vendidaPorId], references: [id], onDelete: SetNull)
  abonoDayPass   Membresia?      @relation("AbonoDayPass", fields: [abonoDayPassId], references: [id], onDelete: SetNull)
  abonadaEn      Membresia?      @relation("AbonoDayPass")
  pagos          Pago[]
  congelamientos Congelamiento[]
  invitados      Invitado[]

  @@index([socioId, fechaFinAjustada])
  @@index([planId])
  @@index([vendidaPorId])
  @@map("membresias")
}

/// Pausa de una membresía que extiende su vencimiento.
model Congelamiento {
  id          Int      @id @default(autoincrement())
  membresiaId Int
  fechaInicio DateTime @db.Date
  fechaFin    DateTime @db.Date
  dias        Int
  motivo      String   @db.VarChar(255)
  creadoPorId Int?
  createdAt   DateTime @default(now())

  membresia Membresia @relation(fields: [membresiaId], references: [id], onDelete: Cascade)
  creadoPor Usuario?  @relation(fields: [creadoPorId], references: [id], onDelete: SetNull)

  @@index([membresiaId])
  @@index([creadoPorId])
  @@map("congelamientos")
}

/// Pase de cortesía: acompañante asociado a un socio titular.
model Invitado {
  id               Int      @id @default(autoincrement())
  socioId          Int
  membresiaId      Int
  nombre           String   @db.VarChar(120)
  documento        String   @db.VarChar(30)
  telefono         String?  @db.VarChar(30)
  fecha            DateTime @default(now())
  registradoPorId  Int?

  socio         Socio     @relation(fields: [socioId], references: [id], onDelete: Cascade)
  membresia     Membresia @relation(fields: [membresiaId], references: [id], onDelete: Cascade)
  registradoPor Usuario?  @relation(fields: [registradoPorId], references: [id], onDelete: SetNull)

  @@index([socioId, fecha])
  @@index([membresiaId])
  @@index([registradoPorId])
  @@map("invitados")
}

/// Turno de caja (apertura / cierre diario por recepcionista).
model CajaTurno {
  id                 Int        @id @default(autoincrement())
  usuarioId          Int
  turno              Turno
  estado             EstadoCaja @default(ABIERTA)
  apertura           DateTime   @default(now())
  cierre             DateTime?
  montoInicial       Decimal    @default(0) @db.Decimal(12, 2)
  totalEfectivo      Decimal    @default(0) @db.Decimal(12, 2)
  totalTarjeta       Decimal    @default(0) @db.Decimal(12, 2)
  totalTransferencia Decimal    @default(0) @db.Decimal(12, 2)
  efectivoContado    Decimal?   @db.Decimal(12, 2)
  diferencia         Decimal?   @db.Decimal(12, 2)
  observaciones      String?    @db.VarChar(255)

  usuario Usuario @relation(fields: [usuarioId], references: [id])
  pagos   Pago[]

  @@index([usuarioId, estado])
  @@map("cajas_turno")
}

/// Pago recibido (total o abono parcial) de una membresía.
model Pago {
  id          Int          @id @default(autoincrement())
  socioId     Int
  membresiaId Int?
  cajaId      Int?
  usuarioId   Int?
  monto       Decimal      @db.Decimal(12, 2)
  metodo      MetodoPago
  concepto    ConceptoPago @default(MEMBRESIA)
  referencia  String?      @db.VarChar(80)
  nota        String?      @db.VarChar(255)
  fecha       DateTime     @default(now())

  socio     Socio      @relation(fields: [socioId], references: [id], onDelete: Cascade)
  membresia Membresia? @relation(fields: [membresiaId], references: [id], onDelete: SetNull)
  caja      CajaTurno? @relation(fields: [cajaId], references: [id], onDelete: SetNull)
  usuario   Usuario?   @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([fecha])
  @@index([socioId])
  @@index([membresiaId])
  @@index([cajaId])
  @@index([usuarioId])
  @@map("pagos")
}

/// Bitácora de cada intento de ingreso por el torniquete / kiosko.
model Acceso {
  id                 Int             @id @default(autoincrement())
  socioId            Int?
  valorIngresado     String          @db.VarChar(80)
  metodo             MetodoAcceso
  tipo               TipoAcceso      @default(SOCIO)
  resultado          ResultadoAcceso
  motivo             String?         @db.VarChar(255)
  fecha              DateTime        @default(now())
  usuarioId          Int?

  socio   Socio?   @relation(fields: [socioId], references: [id], onDelete: SetNull)
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([fecha])
  @@index([socioId, fecha])
  @@index([usuarioId])
  @@map("accesos")
}

/// Clase grupal recurrente semanal.
model ClaseGrupal {
  id           Int      @id @default(autoincrement())
  nombre       String   @db.VarChar(80)
  disciplina   String   @db.VarChar(40)
  instructorId Int?
  /// Día ISO de la semana (1 = lunes … 7 = domingo)
  diaSemana    Int
  horaInicio   String   @db.VarChar(5)
  horaFin      String   @db.VarChar(5)
  aforoMax     Int
  sala         String   @db.VarChar(40)
  activa       Boolean  @default(true)
  createdAt    DateTime @default(now())

  instructor Usuario?  @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  reservas   Reserva[]

  @@index([diaSemana])
  @@index([instructorId])
  @@map("clases_grupales")
}

/// Reserva de cupo de un socio en una sesión (fecha concreta) de una clase.
model Reserva {
  id        Int           @id @default(autoincrement())
  claseId   Int
  socioId   Int
  fecha     DateTime      @db.Date
  estado    EstadoReserva @default(CONFIRMADA)
  createdAt DateTime      @default(now())

  clase ClaseGrupal @relation(fields: [claseId], references: [id], onDelete: Cascade)
  socio Socio       @relation(fields: [socioId], references: [id], onDelete: Cascade)

  @@unique([claseId, socioId, fecha])
  @@index([socioId])
  @@map("reservas")
}

/// Evaluación / valoración física registrada por un instructor.
model EvaluacionFisica {
  id             Int      @id @default(autoincrement())
  socioId        Int
  instructorId   Int?
  fecha          DateTime @default(now())
  pesoKg         Decimal  @db.Decimal(5, 2)
  estaturaCm     Decimal  @db.Decimal(5, 2)
  grasaCorporal  Decimal? @db.Decimal(5, 2)
  masaMuscular   Decimal? @db.Decimal(5, 2)
  notas          String?  @db.Text

  socio      Socio    @relation(fields: [socioId], references: [id], onDelete: Cascade)
  instructor Usuario? @relation(fields: [instructorId], references: [id], onDelete: SetNull)

  @@index([socioId])
  @@index([instructorId])
  @@map("evaluaciones_fisicas")
}
